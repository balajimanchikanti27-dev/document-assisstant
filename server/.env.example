# Backend Port
PORT=5000

# Client Application URL (for CORS allowance)
CLIENT_URL=http://localhost:3000

# Google Gemini API Key for Embeddings and RAG Answer Generation
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Tavily Web Search API Key (for external web research)
# Obtain from https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Persistent Storage Directories (Optional - defaults to server/data and server/uploads)
# Set for persistent volumes in cloud deployments (e.g. Render persistent disk: /var/data)
# DATA_DIR=/var/data
# UPLOADS_DIR=/var/data/uploads
