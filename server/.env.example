# Backend Port (Used for local development)
PORT=5000

# Client Application URL (for CORS allowance in standalone mode)
CLIENT_URL=http://localhost:3000

# Google Gemini API Key for Embeddings and RAG Answer Generation
# Obtain from https://aistudio.google.com/apikey (starts with "AIzaSy...")
GEMINI_API_KEY=AIzaSyYourGoogleAIStudioKeyHere

# Gemini Model (default: gemini-2.5-flash, supports gemini-3.8-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Tavily Web Search API Key (optional for external web research; Wikipedia REST API is active automatically)
# Obtain from https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Persistent Storage Directories (Optional - on Vercel defaults automatically to /tmp/ai-assistant)
# DATA_DIR=/tmp/ai-assistant/data
# UPLOADS_DIR=/tmp/ai-assistant/uploads
