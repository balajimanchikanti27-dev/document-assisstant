# Dependencies
node_modules/
server/node_modules/
/.pnp
.pnp.js

# Production build artifacts
/dist/
/build/
# server/dist is tracked so Render has compiled JS ready on deployment
/server/build/
.vercel/

# Environment files and credentials (CRITICAL: Never commit secrets)
.env
.env.local
.env.*.local
server/.env
server/.env.local
server/.env.*.local
serviceAccountKey.json
*service-account*.json
firebase-adminsdk*.json
*.pem
*.key

# Firebase debug logs and cache
firebase-debug.log
firebase-debug.*.log
.firebase/

# Editor & OS files
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.idea/
.vscode/

# Build caches & logs
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/
.vite/
.eslintcache

# Python bytecode and caches
__pycache__/
server/__pycache__/
*.py[cod]
*$py.class

# Scratch & temporary test scripts
scratch/

# Large server runtime vector index and generated caches
server/data/vector_index.json
server/data/test_uploads/
server/data/study_coach/attempts/
server/data/study_coach/quizzes/
server/data/study_coach/progress/
server/data/study_coach/important_questions/
server/data/study_summaries/

# Runtime file uploads (Exclude dynamic user uploads while preserving existing repository test baselines)
server/uploads/temp/*
!server/uploads/temp/.gitkeep
server/uploads/documents/*
!server/uploads/documents/.gitkeep
!server/uploads/documents/buW1XmhCvKSfK2KFIR9Lu13zezk1__doc_1792156713879_xpyhmsd__Exception_Handling.pptx
!server/uploads/documents/buW1XmhCvKSfK2KFIR9Lu13zezk1__doc_1792863599850_9o571x9__M2-Unit1.pptx
